    affiliation: Universidad Industrial de Santander (UIS)
type: thesis
date-released: 2026-11-16
license: MIT
repository-code: "https://github.com/danielparra2/quantum-dot-chain-impurity"
keywords:
  - quantum dots
  - donor impurity
  - finite element method
  - COMSOL
  - GaAs/AlGaAs
  - optoelectronics
  - scientific computing
